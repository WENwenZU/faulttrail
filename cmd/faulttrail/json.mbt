///| Machine-readable rendering of an outcome.
///
/// `next --json` prints one JSON object so a script (or CI job) can read the
/// candidates, the suggestion, the conflicting records or the blocked reasons
/// without parsing prose. The schema is deliberately flat and stable; the
/// human-readable `next` output is unchanged.

///|
/// Escape a string for JSON. Keys and reasons are generated by the engine, but
/// escaping is unconditional so a future free-text field cannot break the
/// document.
fn json_escape(text : String) -> String {
  let out = StringBuilder::StringBuilder()
  for character in text {
    let code = character.to_int()
    if character == '"' {
      out.write_string("\\\"")
    } else if character == '\\' {
      out.write_string("\\\\")
    } else if code < 32 {
      out.write_string("\\u00")
      out.write_string(hex2(code))
    } else {
      out.write_char(character)
    }
  }
  out.to_string()
}

///|
fn hex2(code : Int32) -> String {
  let digits = "0123456789abcdef"
  let high = digits[code / 16:code / 16 + 1].to_owned()
  let low = digits[code % 16:code % 16 + 1].to_owned()
  high + low
}

///|
fn quoted(text : String) -> String {
  "\"" + json_escape(text) + "\""
}

///|
/// Render an outcome as a single-line JSON object.
pub fn outcome_json(outcome : @engine.Outcome) -> String {
  match outcome {
    @engine.NeedObservation(advice) => {
      let out = StringBuilder::StringBuilder()
      out.write_string("{\"outcome\":\"need-observation\"")
      out.write_string(
        ",\"candidates\":{\"lo\":\{advice.span.lo},\"hi\":\{advice.span.hi}}",
      )
      out.write_string(
        ",\"next\":{\"index\":\{advice.index},\"commit\":\{quoted(advice.commit_id)}}",
      )
      out.write_string(",\"why\":\{quoted(advice.why)}}")
      out.to_string()
    }
    @engine.Located(found) => {
      let out = StringBuilder::StringBuilder()
      out.write_string("{\"outcome\":\"located\"")
      out.write_string(",\"index\":\{found.index}")
      out.write_string(",\"commit\":\{quoted(found.commit_id)}")
      out.write_string(",\"why\":\{quoted(found.why)}}")
      out.to_string()
    }
    @engine.Ambiguous(report) => {
      let out = StringBuilder::StringBuilder()
      out.write_string("{\"outcome\":\"ambiguous\"")
      out.write_string(
        ",\"candidates\":{\"lo\":\{report.span.lo},\"hi\":\{report.span.hi}}",
      )
      out.write_string(",\"blocked\":[")
      let mut first = true
      for note in report.blocked {
        if !first {
          out.write_string(",")
        }
        first = false
        out.write_string(
          "{\"index\":\{note.index},\"commit\":\{quoted(note.commit_id)},\"reason\":\{quoted(note.reason)}}",
        )
      }
      out.write_string("]")
      out.write_string(",\"why\":\{quoted(report.why)}}")
      out.to_string()
    }
    @engine.Conflict(report) => {
      let out = StringBuilder::StringBuilder()
      out.write_string("{\"outcome\":\"conflict\"")
      out.write_string(
        ",\"good\":{\"observation\":\{report.good.obs_id},\"index\":\{report.good.index},\"commit\":\{quoted(report.good.commit_id)}}",
      )
      out.write_string(
        ",\"bad\":{\"observation\":\{report.bad.obs_id},\"index\":\{report.bad.index},\"commit\":\{quoted(report.bad.commit_id)}}",
      )
      out.write_string(",\"why\":\{quoted(report.why)}}")
      out.to_string()
    }
    @engine.Insufficient(report) => {
      let out = StringBuilder::StringBuilder()
      out.write_string("{\"outcome\":\"insufficient\"")
      out.write_string(",\"missing_good\":\{report.missing_good}")
      out.write_string(",\"missing_bad\":\{report.missing_bad}")
      out.write_string(",\"why\":\{quoted(report.why)}}")
      out.to_string()
    }
    @engine.Budget(report) => {
      let out = StringBuilder::StringBuilder()
      out.write_string("{\"outcome\":\"budget\"")
      out.write_string(",\"kind\":\{quoted(report.kind)}")
      out.write_string(",\"limit\":\{report.limit}")
      out.write_string(",\"detail\":\{quoted(report.detail)}}")
      out.to_string()
    }
  }
}
