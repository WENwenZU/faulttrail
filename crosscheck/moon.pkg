// Derived Eq/Debug impls on public enums trigger a toolchain migration notice
// (implicit_impl_as_method) in 0.10.18; the derived impls are still correct.
warnings = "-implicit_impl_as_method"

// This package contains white-box cross-check tests only, so every import is
// needed by the test compilation unit and none by a library build.
import {
  "WENwenZU/faulttrail/engine",
  "WENwenZU/faulttrail/reference",
  "WENwenZU/faulttrail/session",
  "WENwenZU/faulttrail/version",
} for "wbtest"
